	`created_at` int(11) NOT NULL,
	`updated_at` int(11) NOT NULL
)";i:1;i:80;i:2;s:23:"yii\db\Command::execute";i:3;d:1789744969.577524;i:4;a:0:{}i:5;i:6586040;}i:834;a:6:{i:0;s:973:"CREATE TABLE `market_indicator` (
