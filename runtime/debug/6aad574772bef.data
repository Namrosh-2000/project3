    `kcu`.`CONSTRAINT_NAME` AS `constraint_name`,
    `kcu`.`COLUMN_NAME` AS `column_name`,
    `kcu`.`REFERENCED_TABLE_NAME` AS `referenced_table_name`,
    `kcu`.`REFERENCED_COLUMN_NAME` AS `referenced_column_name`
FROM `information_schema`.`REFERENTIAL_CONSTRAINTS` AS `rc`
JOIN `information_schema`.`KEY_COLUMN_USAGE` AS `kcu` ON
    (
        `kcu`.`CONSTRAINT_CATALOG` = `rc`.`CONSTRAINT_CATALOG` OR
        (`kcu`.`CONSTRAINT_CATALOG` IS NULL AND `rc`.`CONSTRAINT_CATALOG` IS NULL)
    ) AND
    `kcu`.`CONSTRAINT_SCHEMA` = `rc`.`CONSTRAINT_SCHEMA` AND
    `kcu`.`CONSTRAINT_NAME` = `rc`.`CONSTRAINT_NAME`
WHERE `rc`.`CONSTRAINT_SCHEMA` = database() AND `kcu`.`TABLE_SCHEMA` = database()
AND `rc`.`TABLE_NAME` = 'migration' AND `kcu`.`TABLE_NAME` = 'migration'";i:1;i:80;i:2;s:21:"yii\db\Command::query";i:3;d:1789744969.574862;i:4;a:0:{}i:5;i:6561584;}i:827;a:6:{i:0;s:774:"SELECT
    `kcu`.`CONSTRAINT_NAME` AS `constraint_name`,
    `kcu`.`COLUMN_NAME` AS `column_name`,
    `kcu`.`REFERENCED_TABLE_NAME` AS `referenced_table_name`,
    `kcu`.`REFERENCED_COLUMN_NAME` AS `referenced_column_name`
FROM `information_schema`.`REFERENTIAL_CONSTRAINTS` AS `rc`
JOIN `information_schema`.`KEY_COLUMN_USAGE` AS `kcu` ON
    (
        `kcu`.`CONSTRAINT_CATALOG` = `rc`.`CONSTRAINT_CATALOG` OR
        (`kcu`.`CONSTRAINT_CATALOG` IS NULL AND `rc`.`CONSTRAINT_CATALOG` IS NULL)
    ) AND
    `kcu`.`CONSTRAINT_SCHEMA` = `rc`.`CONSTRAINT_SCHEMA` AND
    `kcu`.`CONSTRAINT_NAME` = `rc`.`CONSTRAINT_NAME`
WHERE `rc`.`CONSTRAINT_SCHEMA` = database() AND `kcu`.`TABLE_SCHEMA` = database()
AND `rc`.`TABLE_NAME` = 'migration' AND `kcu`.`TABLE_NAME` = 'migration'";i:1;i:96;i:2;s:21:"yii\db\Command::query";i:3;d:1789744969.57625;i:4;a:0:{}i:5;i:6562848;}i:829;a:6:{i:0;s:118:"INSERT INTO `migration` (`version`, `apply_time`) VALUES ('m260918_090000_create_local_data_source_table', 1789744969)";i:1;i:80;i:2;s:23:"yii\db\Command::execute";i:3;d:1789744969.57634;i:4;a:0:{}i:5;i:6562184;}i:830;a:6:{i:0;s:118:"INSERT INTO `migration` (`version`, `apply_time`) VALUES ('m260918_090000_create_local_data_source_table', 1789744969)";i:1;i:96;i:2;s:23:"yii\db\Command::execute";i:3;d:1789744969.576707;i:4;a:0:{}i:5;i:6562576;}i:833;a:6:{i:0;s:973:"CREATE TABLE `market_indicator` (
	`id` int(11) NOT NULL AUTO_INCREMENT PRIMARY KEY,
	`location_id` int(11) NOT NULL,
	`category_id` int(11) NULL DEFAULT NULL COMMENT 'null = applies to the whole ward, not one business category',
	`data_source_id` int(11) NOT NULL,
	`indicator_type` varchar(30) NOT NULL COMMENT 'demand, competition, market_strength, gaps, fit, risk, density',
	`value_numeric` decimal(12,2) NULL DEFAULT NULL COMMENT 'optional quantitative reading, e.g. estimated resident count',
	`value_label` varchar(100) NULL DEFAULT NULL COMMENT 'optional qualitative reading, e.g. \"Juu\", \"Wastani\", \"Chini\"',
	`confidence_level` varchar(10) NOT NULL DEFAULT 'low' COMMENT 'low, medium, high — how much this reading should be trusted',
	`notes` text NULL DEFAULT NULL,
